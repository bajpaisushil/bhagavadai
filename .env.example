# Copy to .env and adjust. Nothing here is required for local development.

# Where Hugging Face caches model weights (default: ~/.cache/huggingface).
# HF_HOME=/path/to/hf-cache

# Optional: a read-only Hugging Face token raises download rate limits. Never commit it.
# HF_TOKEN=

# Apple Silicon: let unsupported MPS ops fall back to CPU (slow). Leave unset during
# compatibility checks so unsupported ops are reported instead of hidden.
# PYTORCH_ENABLE_MPS_FALLBACK=1

# Override the project root if you run the CLI from elsewhere.
# BHAGAVATAM_ROOT=/path/to/bhagavadai
